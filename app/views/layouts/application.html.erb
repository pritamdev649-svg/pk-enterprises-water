<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <title><%= content_for(:title) || "Neer Aqua by P. K. Enterprises | Packaged Drinking Water Manufacturer" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="P. K. Enterprises manufactures Neer Aqua packaged drinking water in 250ml, 500ml, 1 litre and 2 litre bottles. Bulk B2B supply for retailers, distributors, wholesalers and institutions. Call 9069332151.">
    <meta name="theme-color" content="#0a4f66">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= yield :head %>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-50 text-slate-800 font-['Plus_Jakarta_Sans',sans-serif] antialiased selection:bg-sky-500 selection:text-white" data-controller="modal" data-action="keydown@window->modal#handleKeydown">
    <%= render "shared/navbar" %>

    <main>
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
    <%= render "pages/quotation_modal" %>
  </body>
</html>
