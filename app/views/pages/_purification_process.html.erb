<section id="purification" class="py-20 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold tracking-widest text-sky-600 uppercase bg-sky-100 px-3 py-1 rounded-full">
        State-Of-The-Art Cleanroom Plant
      </span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        11-Stage PureStream™ Purification Process
      </h2>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        We eliminate 99.99% of heavy metals, pathogens, and biological contaminants while re-infusing essential minerals (Calcium, Magnesium, Potassium) for an exceptionally crisp taste.
      </p>
    </div>

    <!-- 11 Stages Matrix -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Stage 1 -->
      <div class="bg-white rounded-2xl p-6 shadow-xs hover:shadow-md transition-shadow">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-8 rounded-lg bg-sky-100 text-sky-700 font-bold flex items-center justify-center text-sm">01</span>
          <h3 class="text-base font-bold text-slate-900">Dual Sand Filtration</h3>
        </div>
        <p class="text-xs text-slate-600 leading-relaxed">
          High-rate pressure sand filter beds trap suspended particulate matter, turbidity, and coarse debris down to 20 microns.
        </p>
      </div>

      <!-- Stage 2 -->
      <div class="bg-white rounded-2xl p-6 shadow-xs hover:shadow-md transition-shadow">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-8 rounded-lg bg-sky-100 text-sky-700 font-bold flex items-center justify-center text-sm">02</span>
          <h3 class="text-base font-bold text-slate-900">Activated Carbon Absorption</h3>
        </div>
        <p class="text-xs text-slate-600 leading-relaxed">
          High-iodine coconut shell activated carbon strips residual chlorine, unpleasant odors, colors, and volatile organic compounds (VOCs).
        </p>
      </div>

      <!-- Stage 3 -->
      <div class="bg-white rounded-2xl p-6 shadow-xs hover:shadow-md transition-shadow">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-8 rounded-lg bg-sky-100 text-sky-700 font-bold flex items-center justify-center text-sm">03</span>
          <h3 class="text-base font-bold text-slate-900">Ion Exchange Softening</h3>
        </div>
        <p class="text-xs text-slate-600 leading-relaxed">
          Food-grade resin bed exchanges excess calcium/magnesium ions to eliminate harsh water hardness without damaging mineral balance.
        </p>
      </div>

      <!-- Stage 4 -->
      <div class="bg-white rounded-2xl p-6 shadow-xs hover:shadow-md transition-shadow">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-8 rounded-lg bg-sky-100 text-sky-700 font-bold flex items-center justify-center text-sm">04</span>
          <h3 class="text-base font-bold text-slate-900">10-Micron Micron Pre-Filter</h3>
        </div>
        <p class="text-xs text-slate-600 leading-relaxed">
          High-capacity spun polypropylene cartridges remove fine suspended particles and protect sensitive downstream RO membranes.
        </p>
      </div>

      <!-- Stage 5 -->
      <div class="bg-white rounded-2xl p-6 shadow-xs hover:shadow-md transition-shadow">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-8 rounded-lg bg-sky-100 text-sky-700 font-bold flex items-center justify-center text-sm">05</span>
          <h3 class="text-base font-bold text-slate-900">5-Micron Polishing Filter</h3>
        </div>
        <p class="text-xs text-slate-600 leading-relaxed">
          Precision micro-wound filters ensure microscopic cleanliness and crystal clarity before high-pressure membrane injection.
        </p>
      </div>

      <!-- Stage 6 -->
      <div class="bg-white rounded-2xl p-6 shadow-xs hover:shadow-md transition-shadow ring-1 ring-sky-500/30">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-8 rounded-lg bg-sky-600 text-white font-bold flex items-center justify-center text-sm">06</span>
          <h3 class="text-base font-bold text-slate-900">High-Pressure Reverse Osmosis</h3>
        </div>
        <p class="text-xs text-slate-600 leading-relaxed">
          Dow Filmtec™ semi-permeable membranes filter at 0.0001 microns, purging dissolved solids, arsenic, lead, fluorides, and heavy salts.
        </p>
      </div>

      <!-- Stage 7 -->
      <div class="bg-white rounded-2xl p-6 shadow-xs hover:shadow-md transition-shadow">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-8 rounded-lg bg-sky-100 text-sky-700 font-bold flex items-center justify-center text-sm">07</span>
          <h3 class="text-base font-bold text-slate-900">Active Mineral Remineralization</h3>
        </div>
        <p class="text-xs text-slate-600 leading-relaxed">
          Calibrated bio-dosing restores essential electrolytes ($Ca^{2+}$, $Mg^{2+}$, $K^+$) to establish the signature sweet, crisp mountain taste.
        </p>
      </div>

      <!-- Stage 8 -->
      <div class="bg-white rounded-2xl p-6 shadow-xs hover:shadow-md transition-shadow">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-8 rounded-lg bg-sky-100 text-sky-700 font-bold flex items-center justify-center text-sm">08</span>
          <h3 class="text-base font-bold text-slate-900">TDS & pH Equilibrium Control</h3>
        </div>
        <p class="text-xs text-slate-600 leading-relaxed">
          Real-time digital inline monitoring stabilizes water at healthy mild alkalinity (pH 7.2 - 7.6) and optimal 90-110 TDS.
        </p>
      </div>

      <!-- Stage 9 -->
      <div class="bg-white rounded-2xl p-6 shadow-xs hover:shadow-md transition-shadow">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-8 rounded-lg bg-sky-100 text-sky-700 font-bold flex items-center justify-center text-sm">09</span>
          <h3 class="text-base font-bold text-slate-900">Germicidal UV Disinfection</h3>
        </div>
        <p class="text-xs text-slate-600 leading-relaxed">
          High-intensity 254nm ultraviolet lamps destroy bacterial and viral DNA/RNA instantly with zero chemical byproduct.
        </p>
      </div>

      <!-- Stage 10 -->
      <div class="bg-white rounded-2xl p-6 shadow-xs hover:shadow-md transition-shadow">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-8 rounded-lg bg-sky-100 text-sky-700 font-bold flex items-center justify-center text-sm">10</span>
          <h3 class="text-base font-bold text-slate-900">Venturi Ozonation</h3>
        </div>
        <p class="text-xs text-slate-600 leading-relaxed">
          Ozone ($O_3$) micro-bubble infusion provides long-lasting preservation inside sealed bottles without artificial preservatives.
        </p>
      </div>

      <!-- Stage 11 -->
      <div class="bg-white rounded-2xl p-6 shadow-xs hover:shadow-md transition-shadow">
        <div class="flex items-center gap-3 mb-3">
          <span class="w-8 h-8 rounded-lg bg-sky-100 text-sky-700 font-bold flex items-center justify-center text-sm">11</span>
          <h3 class="text-base font-bold text-slate-900">Sub-Micron Sterile Packaging</h3>
        </div>
        <p class="text-xs text-slate-600 leading-relaxed">
          Final 0.2-micron absolute pharmaceutical filter prior to automated touchless rotary filling and nitrogen-flushed sealing.
        </p>
      </div>

      <!-- Quality Callout Card -->
      <div class="bg-gradient-to-br from-sky-600 to-cyan-700 rounded-2xl p-6 text-white flex flex-col justify-between shadow-md">
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-sky-200">ISO 9001:2015</span>
          <h3 class="text-lg font-bold mt-1">In-House Microbiology Lab</h3>
          <p class="text-xs text-sky-100 mt-2 leading-relaxed">
            Every batch undergoes hourly chemical and microbiological testing. Certificates of Analysis (COA) supplied with every wholesale consignment.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-white/20 flex items-center justify-between text-xs">
          <span>Daily Lab Logs</span>
          <span class="font-bold underline cursor-pointer" data-action="click->modal#open">Request Quality Spec Sheet</span>
        </div>
      </div>

    </div>

  </div>
</section>
