<section id="products" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold tracking-widest text-sky-600 uppercase bg-sky-100/70 px-3 py-1 rounded-full">
        Packaged Drinking Water Lineup
      </span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Precision Bottling for Every Occasion
      </h2>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Engineered with virgin, BPA-free food-grade polymers and bottled in a certified sterile cleanroom facility. Available in generic distribution and private-label custom branding.
      </p>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      
      <!-- 200ml Pocket Bottle -->
      <div class="bg-slate-50/80 rounded-2xl p-6 flex flex-col justify-between transition-all duration-200 hover:shadow-lg hover:bg-sky-50/40">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="px-2.5 py-1 text-xs font-bold rounded-lg bg-sky-100 text-sky-800">Events & Conferences</span>
            <span class="text-xs font-semibold text-slate-400">IS 14543</span>
          </div>

          <!-- Real Bottle Image -->
          <div class="py-3 flex items-center justify-center h-48 overflow-hidden rounded-xl bg-gradient-to-b from-slate-100/50 via-white to-slate-50/40 mb-3 border border-slate-100/80">
            <%= image_tag "bottle_200ml.jpg",
                alt: "P.K. Enterprises 200ml Compact Executive Water Bottle",
                class: "h-44 w-auto object-contain transition-transform duration-300 hover:scale-105 drop-shadow-md" %>
          </div>

          <h3 class="text-lg font-bold text-slate-900 mt-2">200ml Executive</h3>
          <p class="text-xs text-slate-600 mt-1">
            Ideal for corporate boardrooms, airline transit, seminars, and wedding welcome drink trays. Reduces water wastage.
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-200/70">
          <div class="flex items-center justify-between text-xs text-slate-500 mb-3">
            <span>Case Packing:</span>
            <span class="font-bold text-slate-700">48 Units / Case</span>
          </div>
          <button data-action="click->modal#open" class="w-full py-2.5 px-4 rounded-xl bg-white hover:bg-sky-600 hover:text-white text-sky-700 text-xs font-bold shadow-xs border border-sky-200/70 transition-colors duration-200">
            Inquire 200ml Batch
          </button>
        </div>
      </div>

      <!-- 500ml Classic Table Bottle -->
      <div class="bg-sky-50/70 rounded-2xl p-6 flex flex-col justify-between transition-all duration-200 hover:shadow-lg ring-2 ring-sky-500/30 relative">
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-sky-600 text-white text-[10px] font-bold uppercase tracking-wider px-3 py-0.5 rounded-full shadow-xs">
          Best Seller for HORECA
        </div>

        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="px-2.5 py-1 text-xs font-bold rounded-lg bg-sky-200/80 text-sky-900">Fine Dining & Hotels</span>
            <span class="text-xs font-semibold text-slate-400">IS 14543</span>
          </div>

          <!-- Real Bottle Image -->
          <div class="py-3 flex items-center justify-center h-48 overflow-hidden rounded-xl bg-gradient-to-b from-sky-100/50 via-white to-sky-50/30 mb-3 border border-sky-100">
            <%= image_tag "hero_bottle.jpg",
                alt: "P.K. Enterprises 500ml HORECA Premium Water Bottle",
                class: "h-44 w-auto object-contain transition-transform duration-300 hover:scale-105 drop-shadow-md" %>
          </div>

          <h3 class="text-lg font-bold text-slate-900 mt-2">500ml HORECA Premium</h3>
          <p class="text-xs text-slate-600 mt-1">
            The gold standard for hotel guestrooms, restaurant table dining, banquets, and luxury car fleet hospitality.
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-sky-200/60">
          <div class="flex items-center justify-between text-xs text-slate-500 mb-3">
            <span>Case Packing:</span>
            <span class="font-bold text-slate-700">24 Units / Case</span>
          </div>
          <button data-action="click->modal#open" class="w-full py-2.5 px-4 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold shadow-sm transition-colors duration-200">
            Inquire 500ml Batch
          </button>
        </div>
      </div>

      <!-- 1 Litre Retail & Institutional -->
      <div class="bg-slate-50/80 rounded-2xl p-6 flex flex-col justify-between transition-all duration-200 hover:shadow-lg hover:bg-sky-50/40">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="px-2.5 py-1 text-xs font-bold rounded-lg bg-sky-100 text-sky-800">Retail & Travel</span>
            <span class="text-xs font-semibold text-slate-400">IS 14543</span>
          </div>

          <!-- Real Bottle Image -->
          <div class="py-3 flex items-center justify-center h-48 overflow-hidden rounded-xl bg-gradient-to-b from-slate-100/50 via-white to-slate-50/40 mb-3 border border-slate-100/80">
            <%= image_tag "bottle_1l.jpg",
                alt: "P.K. Enterprises 1 Litre Packaged Drinking Water Bottle",
                class: "h-44 w-auto object-contain transition-transform duration-300 hover:scale-105 drop-shadow-md" %>
          </div>

          <h3 class="text-lg font-bold text-slate-900 mt-2">1 Litre Standard</h3>
          <p class="text-xs text-slate-600 mt-1">
            Engineered for all-day hydration, long journeys, retail distribution, corporate cafeterias, and institutional bulk use.
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-200/70">
          <div class="flex items-center justify-between text-xs text-slate-500 mb-3">
            <span>Case Packing:</span>
            <span class="font-bold text-slate-700">12 Units / Case</span>
          </div>
          <button data-action="click->modal#open" class="w-full py-2.5 px-4 rounded-xl bg-white hover:bg-sky-600 hover:text-white text-sky-700 text-xs font-bold shadow-xs border border-sky-200/70 transition-colors duration-200">
            Inquire 1L Batch
          </button>
        </div>
      </div>

      <!-- 20L Bulk Commercial Jar -->
      <div class="bg-slate-50/80 rounded-2xl p-6 flex flex-col justify-between transition-all duration-200 hover:shadow-lg hover:bg-sky-50/40">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="px-2.5 py-1 text-xs font-bold rounded-lg bg-emerald-100 text-emerald-800">Offices & Plants</span>
            <span class="text-xs font-semibold text-slate-400">Heavy-Duty</span>
          </div>

          <!-- Real Bottle Image -->
          <div class="py-3 flex items-center justify-center h-48 overflow-hidden rounded-xl bg-gradient-to-b from-slate-100/50 via-white to-slate-50/40 mb-3 border border-slate-100/80">
            <%= image_tag "bottle_20l.jpg",
                alt: "P.K. Enterprises 20 Litre Bulk Water Dispenser Jar",
                class: "h-44 w-auto object-contain transition-transform duration-300 hover:scale-105 drop-shadow-md" %>
          </div>

          <h3 class="text-lg font-bold text-slate-900 mt-2">20L Bulk Dispenser Jar</h3>
          <p class="text-xs text-slate-600 mt-1">
            Ultra-hygienic automated wash & refill system for offices, IT parks, factories, and schools. Scheduled daily/weekly route delivery.
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-200/70">
          <div class="flex items-center justify-between text-xs text-slate-500 mb-3">
            <span>Refill Type:</span>
            <span class="font-bold text-slate-700">Tamper-Proof Bubble Top</span>
          </div>
          <button data-action="click->modal#open" class="w-full py-2.5 px-4 rounded-xl bg-white hover:bg-emerald-600 hover:text-white text-emerald-700 text-xs font-bold shadow-xs border border-emerald-200/70 transition-colors duration-200">
            Setup Office Route Delivery
          </button>
        </div>
      </div>

    </div>
  </div>
</section>
