<section id="products" class="py-20 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold tracking-widest text-sky-600 uppercase bg-sky-100/70 px-3 py-1 rounded-full">
        Neer Aqua Product Range
      </span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        250 मिली • 500 मिली • 1 लीटर • 2 लीटर
      </h2>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Neer Aqua packaged drinking water with added minerals, available in four practical sizes for retail counters, distributors, hotels, offices, institutions and events. Bulk and repeat orders welcome.
      </p>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <% [
        { size: "250ml", title: "250 ml Pocket", image: "neer_aqua_250ml.jpg", tag: "Events & Meetings",
          text: "Compact bottle for seminars, weddings, catering, conferences and counter sales. Less wastage per guest.", featured: false },
        { size: "500ml", title: "500 ml Classic", image: "neer_aqua_500ml.jpg", tag: "Retail Best Seller",
          text: "The everyday bottle for shops, hotels, restaurants, travel and offices. Fast-moving retail size.", featured: true },
        { size: "1000ml", title: "1 Litre Standard", image: "neer_aqua_1l.jpg", tag: "Retail & Travel",
          text: "All-day hydration for travellers, retail distribution, corporate cafeterias and institutional supply.", featured: false },
        { size: "2000ml", title: "2 Litre Family", image: "neer_aqua_2l.jpg", tag: "Family & Bulk Use",
          text: "Large-format bottle for homes, offices, catering kitchens and group consumption at better value.", featured: false }
      ].each do |p| %>
        <div class="<%= p[:featured] ? 'bg-sky-50 ring-2 ring-sky-500/30 relative' : 'bg-white' %> rounded-2xl p-6 flex flex-col justify-between transition-all duration-200 hover:shadow-lg shadow-xs">
          <% if p[:featured] %>
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-sky-600 text-white text-[10px] font-bold uppercase tracking-wider px-3 py-0.5 rounded-full shadow-xs whitespace-nowrap">
              Most Popular
            </div>
          <% end %>
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="px-2.5 py-1 text-xs font-bold rounded-lg bg-sky-100 text-sky-800"><%= p[:tag] %></span>
              <span class="text-xs font-semibold text-[#5c9a3a]">Neer Aqua</span>
            </div>

            <div class="flex items-center justify-center h-64 overflow-hidden rounded-xl bg-gradient-to-b from-sky-50 to-white mb-3 border border-slate-100">
              <%= image_tag p[:image],
                  alt: "Neer Aqua #{p[:title]} packaged drinking water bottle",
                  class: "h-full w-auto object-contain transition-transform duration-300 hover:scale-105" %>
            </div>

            <h3 class="text-lg font-bold text-slate-900 mt-2"><%= p[:title] %></h3>
            <p class="text-xs text-slate-600 mt-1"><%= p[:text] %></p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-200/70">
            <button data-action="click->modal#open" data-size="<%= p[:size] %>" class="w-full py-2.5 px-4 rounded-xl <%= p[:featured] ? 'bg-sky-600 hover:bg-sky-700 text-white' : 'bg-white hover:bg-sky-600 hover:text-white text-sky-700 border border-sky-200/70' %> text-xs font-bold shadow-xs transition-colors duration-200">
              Order <%= p[:title] %>
            </button>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Trade Offer Banner -->
    <div class="mt-12 rounded-3xl bg-gradient-to-r from-[#0a4f66] to-sky-700 p-6 sm:p-8 text-white flex flex-col md:flex-row items-center justify-between gap-6 shadow-lg">
      <div class="text-center md:text-left">
        <p class="text-xl sm:text-2xl font-extrabold">रिटेलर • डिस्ट्रीब्यूटर • होलसेलर &mdash; <span class="text-amber-300">10% छूट</span></p>
        <p class="text-sm text-sky-100 mt-1">Special trade discount for retailers, distributors and wholesalers of Neer Aqua.</p>
      </div>
      <a href="tel:+919069332151" class="shrink-0 inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white text-[#0a4f66] font-extrabold text-lg shadow-md hover:bg-sky-50 transition">
        📞 ऑर्डर: 9069332151
      </a>
    </div>
  </div>
</section>
