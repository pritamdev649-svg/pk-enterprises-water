<section id="industries" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold tracking-widest text-sky-600 uppercase bg-sky-100 px-3 py-1 rounded-full">
        Who We Serve
      </span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Bulk Supply for Every Business Segment
      </h2>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        From local retailers to regional distributors and institutional buyers, P. K. Enterprises focuses on repeat and bulk B2B orders with timely delivery and consistent quality.
      </p>
    </div>

    <!-- Segment Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% [
        ["🚚", "Distributors & Dealers", "Regional distribution partnerships with dependable stock availability and trade discounts.", "bg-sky-600"],
        ["🏪", "Retailers & Wholesalers", "Fast-moving Neer Aqua sizes for shops, supermarkets and wholesale counters &mdash; 10% trade discount.", "bg-emerald-600"],
        ["🍽️", "Hotels, Restaurants & Catering", "Regular supply of 250 ml and 500 ml bottles for dining tables, rooms, banquets and catering.", "bg-cyan-600"],
        ["🏢", "Corporate Offices", "Scheduled bulk delivery for offices, commercial establishments, meetings and cafeterias.", "bg-[#0a4f66]"],
        ["🎉", "Events & Weddings", "Large-volume supply for weddings, functions, promotional events and gatherings.", "bg-amber-500"],
        ["🏷️", "Private-Label / OEM", "Customized bottles under your own brand or packaging specifications, where commercially feasible.", "bg-[#5c9a3a]"]
      ].each do |icon, title, text, color| %>
        <div class="p-7 rounded-3xl bg-slate-50 hover:bg-sky-50/50 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl <%= color %> text-white flex items-center justify-center mb-5 shadow-md text-2xl">
              <%= icon %>
            </div>
            <h3 class="text-xl font-bold text-slate-900"><%= title %></h3>
            <p class="text-sm text-slate-600 mt-2 leading-relaxed"><%== text %></p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-200">
            <button data-action="click->modal#open" class="text-xs font-bold text-sky-600 hover:text-sky-700 flex items-center gap-1">
              Request Quote <span>&rarr;</span>
            </button>
          </div>
        </div>
      <% end %>
    </div>

  </div>
</section>
