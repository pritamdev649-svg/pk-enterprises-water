<section id="industries" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold tracking-widest text-sky-600 uppercase bg-sky-100 px-3 py-1 rounded-full">
        Enterprise Solutions
      </span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Tailored Water Solutions Across Key Sectors
      </h2>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        From five-star hotel suites and destination weddings to corporate headquarters and international airlines, our custom packaged water elevates brand identity.
      </p>
    </div>

    <!-- Industry Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      <!-- Hotels & Resorts -->
      <div class="p-8 rounded-3xl bg-slate-50 hover:bg-sky-50/50 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-sky-600 text-white flex items-center justify-center mb-6 shadow-md shadow-sky-500/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900">Luxury Hotels & Resorts</h3>
          <p class="text-sm text-slate-600 mt-2 leading-relaxed">
            Personalized 500ml glass or matte-finish PET bottles for guest room turndown service, fine dining restaurants, and banquet halls.
          </p>
          <ul class="mt-4 space-y-2 text-xs text-slate-500 font-medium">
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span> Gold / Silver Foil Stamped Labels
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span> Scheduled Daily/Weekly Bulk Dispatch
            </li>
          </ul>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200">
          <button data-action="click->modal#open" class="text-xs font-bold text-sky-600 hover:text-sky-700 flex items-center gap-1">
            Request Hospitality SOW <span>&rarr;</span>
          </button>
        </div>
      </div>

      <!-- Corporate & Tech Parks -->
      <div class="p-8 rounded-3xl bg-slate-50 hover:bg-sky-50/50 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-cyan-600 text-white flex items-center justify-center mb-6 shadow-md shadow-cyan-500/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900">Corporate Headquarters</h3>
          <p class="text-sm text-slate-600 mt-2 leading-relaxed">
            Co-branded boardroom 200ml bottles and 20L touchless dispenser jars for technology campuses, banks, and MNC offices.
          </p>
          <ul class="mt-4 space-y-2 text-xs text-slate-500 font-medium">
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-cyan-500"></span> Corporate Logo Integration
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-cyan-500"></span> Centralized Monthly Invoicing & GST
            </li>
          </ul>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200">
          <button data-action="click->modal#open" class="text-xs font-bold text-cyan-600 hover:text-cyan-700 flex items-center gap-1">
            Request Corporate Quote <span>&rarr;</span>
          </button>
        </div>
      </div>

      <!-- Grand Weddings & Events -->
      <div class="p-8 rounded-3xl bg-slate-50 hover:bg-sky-50/50 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-amber-500 text-white flex items-center justify-center mb-6 shadow-md shadow-amber-500/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900">Destination Weddings</h3>
          <p class="text-sm text-slate-600 mt-2 leading-relaxed">
            Custom monogrammed wedding water bottles with bride & groom names, event dates, and royal themes for hospitality hampers.
          </p>
          <ul class="mt-4 space-y-2 text-xs text-slate-500 font-medium">
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Customized Couple Monograms
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Express 48-Hour Event Delivery
            </li>
          </ul>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200">
          <button data-action="click->modal#open" class="text-xs font-bold text-amber-600 hover:text-amber-700 flex items-center gap-1">
            Request Wedding Sample Box <span>&rarr;</span>
          </button>
        </div>
      </div>

    </div>

  </div>
</section>
