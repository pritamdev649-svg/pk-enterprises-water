<section class="relative pt-6 pb-14 md:pt-8 md:pb-20 overflow-hidden bg-gradient-to-b from-sky-100/50 via-sky-50/30 to-white">
  <!-- Subtle Ambient Glows -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] h-[650px] bg-sky-200/40 rounded-full blur-3xl -z-10 pointer-events-none"></div>
  <div class="absolute top-10 right-10 w-80 h-80 bg-emerald-100/50 rounded-full blur-2xl -z-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">

      <!-- Left Column: Copy & Value Proposition -->
      <div class="lg:col-span-7 space-y-4 text-center lg:text-left">
        <!-- Top Pill Badge -->
        <div class="inline-flex flex-wrap items-center justify-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-100/80 text-sky-800 text-xs sm:text-sm font-semibold tracking-wide shadow-xs">
          <span>Neer Aqua Packaged Drinking Water</span>
          <span class="text-sky-400">•</span>
          <span class="text-emerald-700">With Added Minerals</span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-[1.12]">
          Reliable Manufacturing. <br class="hidden sm:inline">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#0a4f66] via-sky-600 to-[#5c9a3a]">
            Consistent Quality.
          </span>
          <br class="hidden sm:inline">
          Competitive Supply.
        </h1>

        <!-- Subtitle -->
        <p class="text-sm sm:text-base text-slate-600 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          P. K. Enterprises manufactures <strong class="text-slate-800">Neer Aqua</strong> packaged drinking water in 250 ml, 500 ml, 1 litre and 2 litre bottles &mdash; supplying distributors, retailers, wholesalers, hotels, offices, institutions and events with dependable bulk orders.
        </p>

        <!-- Trade Offer Strip -->
        <div class="inline-flex flex-wrap items-center justify-center lg:justify-start gap-2 px-4 py-2 rounded-2xl bg-[#0a4f66] text-white text-sm font-semibold shadow-md">
          <span>रिटेलर • डिस्ट्रीब्यूटर • होलसेलर</span>
          <span class="text-white/40">|</span>
          <span class="text-amber-300 font-extrabold">10% छूट</span>
        </div>

        <!-- CTA Action Buttons -->
        <div class="pt-1 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3">
          <a href="tel:+919069332151" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 bg-sky-600 hover:bg-sky-700 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition-all duration-200">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            ऑर्डर: 90693 32151
          </a>

          <a href="https://wa.me/919069332151?text=Hello%20P.%20K.%20Enterprises%2C%20I%20want%20to%20order%20Neer%20Aqua%20water%20bottles." target="_blank" rel="noopener" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl shadow-md transition-all duration-200">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35zM12.04 21.5h-.01a9.45 9.45 0 01-4.82-1.32l-.35-.21-3.58.94.96-3.49-.23-.36a9.43 9.43 0 01-1.45-5.03c0-5.22 4.25-9.46 9.48-9.46 2.53 0 4.9.99 6.69 2.78a9.4 9.4 0 012.77 6.69c0 5.22-4.25 9.46-9.46 9.46zm8.05-17.51A11.32 11.32 0 0012.04.66C5.77.66.66 5.76.66 12.03c0 2 .52 3.96 1.52 5.69L.57 23.6l6.03-1.58a11.36 11.36 0 005.43 1.38h.01c6.27 0 11.37-5.1 11.37-11.37 0-3.04-1.18-5.89-3.33-8.04z"/></svg>
            WhatsApp Order
          </a>

          <button data-action="click->modal#open" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold rounded-xl transition-all duration-200">
            Get Bulk Quote
          </button>
        </div>

        <!-- Metrics Strip -->
        <div class="pt-5 border-t border-slate-200/60 grid grid-cols-3 gap-4 text-center lg:text-left">
          <div>
            <p class="text-2xl sm:text-3xl font-bold text-slate-900">4 Sizes</p>
            <p class="text-xs sm:text-sm text-slate-500 font-medium">250ml • 500ml • 1L • 2L</p>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-bold text-[#5c9a3a]">10% OFF</p>
            <p class="text-xs sm:text-sm text-slate-500 font-medium">For Trade Partners</p>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-bold text-slate-900">B2B</p>
            <p class="text-xs sm:text-sm text-slate-500 font-medium">Bulk & Repeat Orders</p>
          </div>
        </div>
      </div>

      <!-- Right Column: Neer Aqua Range Showcase -->
      <div class="lg:col-span-5 relative flex justify-center">
        <div class="relative w-full max-w-md p-4 sm:p-5 rounded-3xl bg-white/80 backdrop-blur-md shadow-xl border border-sky-100/80">

          <div class="absolute -top-3 -right-3 z-10 bg-emerald-600 text-white px-3 py-1 rounded-full text-xs font-bold shadow-md flex items-center gap-1.5">
            With Added Minerals
          </div>

          <div class="relative overflow-hidden rounded-2xl">
            <%= image_tag "neer_aqua_range.jpg",
                alt: "Neer Aqua packaged drinking water bottles in 250ml, 500ml, 1 litre and 2 litre sizes",
                class: "w-full h-[380px] sm:h-[440px] object-cover object-bottom transition-transform duration-700 hover:scale-105" %>
          </div>

          <div class="mt-3 text-center">
            <p class="text-xs text-slate-500">
              💧 Neer Aqua by P. K. Enterprises &mdash; available for retail, distribution & bulk supply
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
