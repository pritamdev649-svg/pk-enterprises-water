<section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden bg-gradient-to-b from-sky-100/50 via-sky-50/30 to-white">
  <!-- Subtle Ambient Glows -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] h-[650px] bg-sky-200/40 rounded-full blur-3xl -z-10 pointer-events-none"></div>
  <div class="absolute top-10 right-10 w-80 h-80 bg-cyan-100/50 rounded-full blur-2xl -z-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Copy & High-Impact Value Proposition -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <!-- Top Quality Pill Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-100/80 text-sky-800 text-xs sm:text-sm font-semibold tracking-wide shadow-xs">
          <span class="w-2 h-2 rounded-full bg-sky-500 animate-ping"></span>
          <span>BIS IS 14543 & FSSAI Certified Bottler</span>
          <span class="text-sky-400">•</span>
          <span class="text-sky-700">11-Stage PureStream™ Tech</span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">
          Purity in Every Drop, <br class="hidden sm:inline">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-600 via-cyan-600 to-sky-800">
            Prestige on Every Table.
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          P. K. Enterprises crafts ultra-purified packaged drinking water and bespoke private-label bottles for India’s finest luxury hotels, corporate enterprises, fine-dining restaurants, and grand events.
        </p>

        <!-- CTA Action Buttons -->
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a href="#custom-studio" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-sky-600 hover:bg-sky-700 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition-all duration-200">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
            </svg>
            Design Custom Bottle
          </a>
          
          <button data-action="click->modal#open" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold rounded-xl transition-all duration-200">
            <svg class="w-5 h-5 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Request Instant Quote
          </button>
        </div>

        <!-- Metrics Strip -->
        <div class="pt-8 border-t border-slate-200/60 grid grid-cols-3 gap-4 text-center lg:text-left">
          <div>
            <p class="text-2xl sm:text-3xl font-bold text-slate-900">50K+</p>
            <p class="text-xs sm:text-sm text-slate-500 font-medium">Daily Production (BPD)</p>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-bold text-sky-600">11-Stage</p>
            <p class="text-xs sm:text-sm text-slate-500 font-medium">RO + UV + Ozonation</p>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-bold text-slate-900">250+</p>
            <p class="text-xs sm:text-sm text-slate-500 font-medium">B2B Institutional Clients</p>
          </div>
        </div>
      </div>

      <!-- Right Column: Visual Bottle Showcase Card -->
      <div class="lg:col-span-5 relative flex justify-center">
        <!-- Main Ambient Card -->
        <div class="relative w-full max-w-md p-6 sm:p-8 rounded-3xl bg-white/80 backdrop-blur-md shadow-xl border border-sky-100/80">
          
          <!-- Floating Status Badge Top Right -->
          <div class="absolute -top-3 -right-3 bg-emerald-600 text-white px-3 py-1 rounded-full text-xs font-bold shadow-md flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
            100% Food-Grade PET
          </div>

          <!-- Hero Real Bottle Showcase -->
          <div class="py-4 flex flex-col items-center justify-center relative">
            <div class="relative group">
              <!-- Soft luxury ambient glow behind the bottle -->
              <div class="absolute inset-0 bg-gradient-to-t from-sky-400/25 via-cyan-300/15 to-transparent rounded-3xl blur-2xl scale-95 group-hover:scale-105 transition-all duration-700 pointer-events-none"></div>
              
              <div class="relative overflow-hidden rounded-2xl bg-gradient-to-b from-sky-50/40 via-white to-sky-50/30 p-3 shadow-lg border border-sky-100 flex items-center justify-center">
                <%= image_tag "hero_bottle.jpg", 
                    alt: "P. K. Enterprises Royal Aura Natural Mineral Water 500ml Bottle",
                    class: "w-52 sm:w-60 h-[380px] sm:h-[420px] object-contain rounded-xl drop-shadow-2xl transition-transform duration-500 hover:scale-105 animate-waterFloat" %>
              </div>

              <!-- Luxury Floating Seal Badge -->
              <div class="absolute bottom-4 left-1/2 -translate-x-1/2 whitespace-nowrap bg-slate-900/90 backdrop-blur-md text-white text-[11px] font-semibold px-3.5 py-1.5 rounded-full shadow-xl border border-amber-400/40 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                <span class="tracking-wide">Royal Aura • 500ml HORECA Reserve</span>
              </div>
            </div>
          </div>

          <!-- Quick Highlight Specs Bottom -->
          <div class="mt-4 pt-4 border-t border-slate-100 grid grid-cols-2 gap-3 text-xs">
            <div class="bg-sky-50/80 p-2.5 rounded-xl text-center">
              <span class="text-slate-500 block">TDS Balance</span>
              <span class="font-bold text-sky-900">80 - 120 PPM</span>
            </div>
            <div class="bg-sky-50/80 p-2.5 rounded-xl text-center">
              <span class="text-slate-500 block">pH Level</span>
              <span class="font-bold text-sky-900">7.2 - 7.6 (Optimal)</span>
            </div>
          </div>

          <div class="mt-4 text-center">
            <p class="text-xs text-slate-500">
              ⚡ Same-Day Custom Label Proofs Available for Corporate Inquiries
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
